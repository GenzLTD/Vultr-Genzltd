FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    FLASK_PORT=5200

# 本仓面向海外机构建。默认走 Debian / PyPI 官方源，不绑国内镜像。
# 国内网构建再开：--build-arg USE_CN_MIRROR=1 --build-arg PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG USE_CN_MIRROR=0
RUN if [ "$USE_CN_MIRROR" = "1" ]; then \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' \
        /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null || true; \
    fi

COPY requirements.txt .
ARG PIP_INDEX_URL=https://pypi.org/simple/
RUN pip install --no-cache-dir -r requirements.txt -i ${PIP_INDEX_URL}

EXPOSE 5200

# 运行时 /app 由 bind mount 覆盖；此处仅声明启动命令
CMD ["gunicorn", "--config", "gunicorn_config.py", "src.app:create_app()"]
