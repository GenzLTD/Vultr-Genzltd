# Tatha 主仓配置示例（复制为 .env 后填写）
# 模型与 API（LiteLLM 用，任选其一即可）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# DeepSeek：OpenAI 兼容 API，base_url 由 LiteLLM 自动设为 https://api.deepseek.com，只需填 key 与模型名
DEEPSEEK_API_KEY=

# 默认模型名（LiteLLM 格式）
# 示例：openai/gpt-4o | anthropic/claude-3-5-sonnet | deepseek/deepseek-chat（非思考）| deepseek/deepseek-reasoner（思考模式）
TATHA_DEFAULT_MODEL=openai/gpt-4o

# 中央大脑是否用 LLM 做意图解析（true=主路径，false 或未配置 key 时用规则回退）
TATHA_USE_LLM_INTENT=true

# 文档解读后端：pydantic_ai（类型安全边界，默认）| marvin（由 JSON schema 动态生成）
TATHA_DOCUMENT_ANALYSIS_BACKEND=pydantic_ai

# 提取器/分类器 schema（JSON）：按文档类型生产 Marvin 提取/分类函数（当后端为 marvin 时使用）
# TATHA_EXTRACTORS_SCHEMA=config/extractors_schema.example.json

# 私有索引存储根目录（简历等敏感数据仅存于此，不提交；默认 .data/indices）
# TATHA_INDEX_STORAGE=.data/indices
# 索引/检索用 embedding：local（默认，本地 HuggingFace，无需 Key，适配仅配 DeepSeek）| openai
# TATHA_EMBED_MODEL=local
# 向量维度（local 默认 384，openai 默认 1536；可覆盖）
# TATHA_EMBED_DIM=384

# 职位匹配流水线：职位源与返回条数
# TATHA_JOB_SOURCE=mock（默认，示例职位，无需 Key）| apify_linkedin（需 APIFY_API_KEY）
# TATHA_JOB_TOP_N=5
# APIFY_API_KEY=（使用 apify_linkedin 时填写）

# 主仓 API 对外地址（助理 Tool 调用时用）
# 默认 8010，避免与 ServBay 等占用 8000 的服务冲突
TATHA_API_HOST=0.0.0.0
TATHA_API_PORT=8010

# CORS：允许跨域调用 /v1/* 的前端来源（逗号分隔）
# 未配置时默认 *（放行所有来源；Bearer token 鉴权、无 Cookie）
# 上线后建议收紧：TATHA_CORS_ORIGINS=https://tatha.vercel.app
# TATHA_CORS_ORIGINS=

# 数据库（与 JobFirst 主仓对齐时可复用）
# DATABASE_URL=mysql+pymysql://user:pass@localhost/jobfirst_basic
# 向量库（若用独立向量服务）
# VECTOR_STORE_URL=

# ---------- V1 认证与配额 ----------
# 认证服务（V1 以量子认证为主线，主仓校验 token 时调用）
# QUANTUM_AUTH_URL=http://localhost:8xxx/verify
# 未配置时可用 stub：主仓返回固定测试用户与档位

# ---------- Phase 2: Supabase Auth ----------
# 配置以下两项后，/v1/auth/login 和 /v1/auth/register 自动切换为真实 Supabase Auth
# 获取方式：Supabase 项目 → Settings → API
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 前端 anon key（用于 Google OAuth 等客户端 SDK）
# SUPABASE_ANON_KEY=your-anon-key

# 配额存储（按 user_id + tier + 日/月 计数；Redis 或 DB）
# REDIS_URL=redis://localhost:6379/0
# 未配置时可不做配额扣减或仅内存计数（单机）

# 地区与定价（GET /v1/region）：未解析到 IP 时默认国家码（CN | US 等）
# TATHA_DEFAULT_REGION=CN
# 覆盖默认价格（可选）：TATHA_PRICING_CN_BASIC_MONTHLY=99，TATHA_PRICING_INTL_BASIC_MONTHLY=9.9 等

# ---------- Guibu 信号桥（POST /v1/skills/ingest） ----------
# Guibu ↔ Tatha 共享 HMAC 密钥：X-Signature = HMAC-SHA256(SIGNAL_BRIDGE_SECRET, raw_body)
# 已配置则 ingest 强制验签；未配置走 dev 免签（verified=false，仅本地冒烟）
# SIGNAL_BRIDGE_SECRET=change-me-shared-secret
# skills_evidence 表（SQLite）路径，默认 .data/skills_evidence.db（.data 已 gitignore）
# TATHA_EVIDENCE_DB=.data/skills_evidence.db

# 生产门禁：true 时若未配置 SIGNAL_BRIDGE_SECRET，服务启动即抛错，堵死「免签进生产」
# 默认 false（dev 免签，仅本地冒烟）；生产部署务必设为 true
# REQUIRE_SIGNAL_HMAC=true
