{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@looma/shared-core": ["../shared-core/src"],
      "@looma/shared-core/*": ["../shared-core/src/*"],
      "@saas/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.stories.tsx", "src/**/*.stories.ts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
