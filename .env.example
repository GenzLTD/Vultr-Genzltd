# =============================================================
# Vultr-Genzltd — 环境变量模板（仅键清单与安全默认值）
#
#   真值不入库、不进聊天。目标机上由 scripts/seed-env.sh 仅首次种入，
#   之后永不覆盖（发版不再重写 .env —— 这是防密钥漂移的关键）。
#
#   本文件就是海外栈的键清单。本地 dryrun 用它生成 backend/.env 桩。
#   真值不入库。不要去 looma-zervi 再找一份「更权威」的海外 .env。
# =============================================================

# ---------- 进程 / 路径（安全默认值，可直接沿用）----------
FLASK_ENV=production
FLASK_PORT=5200
DATABASE_PATH=/app/data/looma.db
POETRY_CHROMA_PATH=/app/poetry_data

# ---------- 向量库（走 looma-net 服务名，不占宿主端口）----------
CHROMA_MODE=remote
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ---------- 限流（走 looma-net 服务名，不占宿主端口）----------
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1

# ---------- 站点 / 地区 ----------
DEPLOY_REGION=SG
CORS_ORIGINS=https://genz.ltd,https://www.genz.ltd,https://tspace.genz.ltd,https://api.genz.ltd,https://app.genz.ltd,https://tspace.szbolent.cn,http://localhost:5173,http://localhost:5174,http://localhost:3000
GOOGLE_REDIRECT_URI=https://api.genz.ltd/v1/auth/google/callback

# ---------- LLM ----------
LLM_PROVIDER_ORDER=deepseek,openai,ollama
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- 企查查 MCP ----------
QCC_ENABLED=true
QCC_MCP_BASE_URL=http://1.14.202.161:8998/mcp

# ---------- 支付闸门（生产必须为 false）----------
PAYMENT_STUB_MODE=false
WECHAT_DEV_MODE=false
STRIPE_SUCCESS_URL=https://tspace.genz.ltd/pricing?status=success
STRIPE_CANCEL_URL=https://tspace.genz.ltd/pricing?status=cancel

# ---------- 密钥（真值仅由 Secrets 注入；此处必须为空/占位）----------
JWT_SECRET=
DEEPSEEK_API_KEY=
QCC_AUTH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
