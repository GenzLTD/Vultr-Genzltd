# 干跑产物（每次运行由 scripts/dryrun.sh 重新生成）
dryrun/layout/

# tag 工作流在 runner 上生成，不入库（tag 本身即发版记录）
/RELEASE.json

# 从 Vultr /var/www/saas/dist 拉下来的 tspace 产物（不入库）
local/www/tspace/
# 本机 ServBay 用的 genz-web 构建产物
local/www/genz-web/
# 本机 nginx 运行时
local/logs/
local/temp/
local/nginx.pid
local/tmp-*.json

# 环境变量真值
.env
*.env
!.env.example
!backend/.env.example

# 前端工作区
frontend/node_modules/
frontend/packages/*/node_modules/
frontend/packages/*/dist/
frontend/.pnpm-store/

# 后端缓存
**/__pycache__/
*.pyc

# 系统
.DS_Store
Thumbs.db
