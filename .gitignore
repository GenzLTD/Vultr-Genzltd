# 干跑产物（每次运行由 scripts/dryrun.sh 重新生成）
dryrun/layout/

# tag 工作流在 runner 上生成，不入库（tag 本身即发版记录）
/RELEASE.json

# 从 Vultr /var/www/saas/dist 拉下来的 tspace 产物（不入库）
local/www/tspace/
# 本机 ServBay 用的 genz-web 构建产物
local/www/genz-web/
# 本机 nginx 运行时
local/logs/
local/temp/
local/nginx.pid
local/tmp-*.json

# 环境变量真值
.env
*.env
!.env.example
!backend/.env.example

# 前端工作区
frontend/node_modules/
frontend/packages/*/node_modules/
frontend/packages/*/dist/
frontend/.pnpm-store/

# 后端缓存
**/__pycache__/
*.pyc

# 系统
.DS_Store
Thumbs.db

# ============================================================
# 商业 / 法务 / 客户文档 —— 一律不入库   [sensitive-doc-guard v1]
# 本机另有全局规则 ~/.config/git/ignore 兜底；这里再写一份，
# 保证规则随仓库同步到其他机器与协作者。
# 命中示例：香江商学院-深圳外服集团战略合作框架协议(征求意见稿）.docx
# ⚠️ gitignore 是「最后一条匹配的规则胜出」：请勿在本块之后追加
#    !*.txt / !*.csv 之类反选，否则会覆盖下面的显式文件名规则。
# ============================================================

# 清单 / 台账类（含 D:\ 全盘路径、客户名录）
kb_inventory.txt
kb_inventory*.txt
*文件清单*.txt
*目录清单*.txt
*盘清单*.txt

# 合同 / 协议 / 法务文本
*战略合作*
*框架协议*
*合作协议*
*协议*
*合同*
*征求意见稿*
*意向书*
*承诺书*
*授权书*
*委托书*
*保密*
*章程*
*股东决议*
*决议*
*股权*
*尽职调查*
*尽调*
*审计*
*报价*
*标书*
*对账*
*发票*
*营业执照*
*商业计划书*

# 反选：避免中文关键词误伤代码 / 配置文件（.txt/.csv 故意不含在内）
!*.py
!*.js
!*.jsx
!*.ts
!*.tsx
!*.vue
!*.go
!*.rs
!*.java
!*.kt
!*.sql
!*.sh
!*.bash
!*.zsh
!*.md
!*.mdx
!*.json
!*.jsonc
!*.yaml
!*.yml
!*.toml
!*.ini
!*.cfg
!*.html
!*.css
!*.scss
!*.lock
